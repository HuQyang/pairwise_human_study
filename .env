# Local defaults. Copy to .env; never commit database files or real responses.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/study.sqlite
# For GitHub Pages, use the frontend origin (no repository path).
ALLOWED_ORIGINS=https://HuQyang.github.io
# Set before building a separately hosted frontend. Omit for same-origin hosting.
VITE_API_BASE_URL=https://render.com/docs/web-services#port-binding
