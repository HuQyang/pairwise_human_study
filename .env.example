# Local defaults. Copy to .env; never commit database files or real responses.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/study.sqlite
# Hosted Postgres (Neon, Supabase, ...). When set, it is used instead of DATABASE_PATH.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# For GitHub Pages, use the frontend origin (no repository path).
# ALLOWED_ORIGINS=https://YOUR-USERNAME.github.io
# Set before building a separately hosted frontend. Omit for same-origin hosting.
# VITE_API_BASE_URL=https://your-backend.example.com
